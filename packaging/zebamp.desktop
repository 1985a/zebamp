[Desktop Entry]
Type=Application
Name=Zebamp
GenericName=Music player (MPD)
GenericName[es]=Reproductor de música (MPD)
Comment=Winamp-style player for MPD with classic and modern skins
Comment[es]=Reproductor estilo Winamp para MPD con skins clásicos y modernos
Exec=zebamp %F
Icon=zebamp
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/ogg;audio/x-wav;audio/mp4;audio/x-mpegurl;audio/x-scpls;application/vnd.apple.mpegurl;application/x-winamp-skin;application/x-winamp3-skin;
StartupWMClass=zebamp
Keywords=winamp;mpd;music;skins;
Actions=PlayPause;Next;Previous;Search;Lyrics;Radio;Help;

[Desktop Action PlayPause]
Name=Play/Pause
Name[es]=Reproducir/Pausa
Exec=zebamp --play-pausa

[Desktop Action Next]
Name=Next
Name[es]=Siguiente
Exec=zebamp --siguiente

[Desktop Action Previous]
Name=Previous
Name[es]=Anterior
Exec=zebamp --anterior

[Desktop Action Search]
Name=Search songs
Name[es]=Buscar canciones
Exec=zebamp --buscar

[Desktop Action Lyrics]
Name=Lyrics
Name[es]=Letras
Exec=zebamp --letras

[Desktop Action Radio]
Name=Internet radio
Name[es]=Radio por Internet
Exec=zebamp --radio

[Desktop Action Help]
Name=Zebamp help
Name[es]=Ayuda de Zebamp
Exec=zebamp --ayuda
